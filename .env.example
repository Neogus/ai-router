# AI Router - API Keys Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# OpenRouter (https://openrouter.ai/keys) - for free/paid model routing
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic (https://console.anthropic.com/) - direct Anthropic access
ANTHROPIC_API_KEY=sk-ant-your-key-here

# DeepSeek (https://platform.deepseek.com/) - direct DeepSeek access
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Moonshot/Kimi (optional)
MOONSHOT_API_KEY=
KIMI_CODE_API_KEY=
